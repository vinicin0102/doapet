# Porta HTTP
PORT=3000
# Caminho do banco SQLite (padrão: ./data/doapet.db)
# DATABASE_PATH=/var/lib/doapet/doapet.db

# Meta usada somente na PRIMEIRA execução (depois é editada pelo painel)
CAMPAIGN_GOAL=5000,00

# Segredo compartilhado com o provedor Pix para assinar os webhooks (HMAC-SHA256).
# Sem ele o webhook fica desativado. Gere com: openssl rand -hex 32
PIX_WEBHOOK_SECRET=

# Cria o primeiro administrador automaticamente se ainda não houver nenhum.
# Remova estas linhas depois do primeiro acesso.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Em produção (HTTPS) os cookies de sessão são marcados como Secure.
NODE_ENV=production
# Atrás de proxy reverso (Nginx, Render, Railway...), use o IP real do visitante.
TRUST_PROXY=false
