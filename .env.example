# Postgres de produção. Na Vercel, a integração Neon (Storage → Neon) cria esta
# variável automaticamente. Sem ela, em desenvolvimento local, os dados ficam
# no PGlite em ./data/pglite.
DATABASE_URL=

# Meta usada somente na PRIMEIRA execução (depois é editada pelo painel)
CAMPAIGN_GOAL=5000,00

# Cria o primeiro administrador automaticamente se ainda não houver nenhum.
# Senha com no mínimo 10 caracteres.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ZuckPay (processador de pagamentos do quadro de doações).
# Painel ZuckPay > Desenvolvedores > Credenciais API.
ZUCKPAY_CLIENT_ID=
ZUCKPAY_CLIENT_SECRET=
# Painel ZuckPay > keys.php > card "Webhook Secret" (diferente do client secret).
ZUCKPAY_WEBHOOK_SECRET=
# Dados fixos do pagador usados em TODAS as cobranças (o doador não preenche nada).
ZUCKPAY_PAGADOR_NOME=
ZUCKPAY_PAGADOR_CPF=
# Opcional: se vazio, o campo email não é enviado.
ZUCKPAY_PAGADOR_EMAIL=
ZUCKPAY_PAGADOR_TELEFONE=
# Endereço público do site, para a ZuckPay avisar os pagamentos (na Vercel é detectado sozinho).
# SITE_URL=https://doapet.vercel.app

# Supabase Storage (imagens e vídeos enviados pelo painel).
# Supabase > Project Settings > API. A chave secreta (service_role) fica só no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=midias

# Alternativa sem processador (Pix estático, sem confirmação automática):
# dados do recebedor usados para gerar o QR Code Pix.
# PIX_CHAVE aceita e-mail, celular (+5511999999999), CPF, CNPJ ou chave aleatória.
PIX_CHAVE=
PIX_NOME_RECEBEDOR=
PIX_CIDADE=

# Segredo compartilhado com o provedor Pix para assinar os webhooks (HMAC-SHA256).
# Sem ele o webhook fica desativado. Gere com: openssl rand -hex 32
PIX_WEBHOOK_SECRET=

# Fora da Vercel: porta HTTP, HTTPS em produção e proxy reverso.
PORT=3000
NODE_ENV=production
TRUST_PROXY=false

# Higgsfield (exemplo index.ts com Seedance 2.5). Coloque no .env.local, que fica fora do Git.
# Formato key-id:key-secret, gerado no console da Higgsfield. Só no servidor.
# HF_CREDENTIALS=
